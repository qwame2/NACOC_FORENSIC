{
  "info": {
    "_postman_id": "nacoc-forensic-collection-01",
    "name": "NACOC Forensic Directorate API Suite",
    "description": "Postman API Test Suite for NACOC Forensic Directorate Portal. Covers authentication, case creation, lab analysis unit progress, sample weight metrology, and administrative sign-off APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. User Verification - Check Approval Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('User exists and is approved in system', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.exists).to.eql(true);",
              "    pm.expect(jsonData.is_approved).to.eql(true);",
              "    pm.expect(jsonData.username).to.eql('anna');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/check-user-approval?login_id={{login_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "check-user-approval"
          ],
          "query": [
            {
              "key": "login_id",
              "value": "{{login_id}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. Authentication - Officer Login API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API Login returns success JSON and user profile', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.user).to.have.property('service_id');",
              "    pm.expect(jsonData.user.service_id).to.eql('SD-878');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login_id\": \"{{login_id}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      }
    },

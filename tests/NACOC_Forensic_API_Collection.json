          "raw": "{\n  \"case_number\": \"FSD-2026-POSTMAN-01\",\n  \"title\": \"Suspect Docket File - Kofi Mensah\",\n  \"unit_name\": \"Crime Scene Support\",\n  \"suspect_name\": \"Kofi Mensah\",\n  \"suspect_alias\": \"Postman Test Subject\",\n  \"arrest_date\": \"2026-09-14\",\n  \"raid_location\": \"Tema Port Container Terminal 4\",\n  \"offense_description\": \"Attempted Importation of Illicit Substances\",\n  \"seizure_name\": \"Heroin Packages\",\n  \"seizure_quantity\": \"10\",\n  \"seizure_weight\": \"12.4\",\n  \"seizure_unit\": \"KG\",\n  \"presumptive_test_result\": \"YES (Positive Colorimetric Reaction)\",\n  \"confirmatory_test_result\": \"YES\",\n  \"sample_weight_description\": \"10 brick packages wrapped in brown adhesive tape\",\n  \"sample_weight_gross\": \"12.4 kg gross weight\",\n  \"sample_weight_taken\": \"20.0 grams\",\n  \"sample_weight_reserved\": \"12.380 kg\"\n}"

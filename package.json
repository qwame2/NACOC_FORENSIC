        "laravel-vite-plugin": "^2.0.0",
        "oxlint": "^1.83.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "chart.js": "^4.5.1",
        "jquery": "^4.0.0",
        "select2": "^4.1.0"
    }
}
